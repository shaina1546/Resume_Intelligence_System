# ============================================================
# .env.example — Resume Intelligence System
# ============================================================
# Copy this file to ".env" and fill in real values.
# The ".env" file is NEVER committed to Git.
#
# Currently, Version 1 does NOT require any API keys.
# This file is here to prepare for future expansion.
# ============================================================

# --- Application settings ---
APP_TITLE="Resume Intelligence System"
APP_VERSION="1.0.0"

# --- Database ---
# Path to the SQLite database file.
# Leave as default unless you need a custom location.
DATABASE_PATH="resume_intelligence.db"

# --- Semantic Model ---
# Name of the sentence-transformers model to use.
# If this model fails to load, the app falls back to TF-IDF.
SEMANTIC_MODEL="sentence-transformers/all-MiniLM-L6-v2"

# --- Future: LLM API keys (NOT used in Version 1) ---
# OPENAI_API_KEY=your_key_here
# GEMINI_API_KEY=your_key_here
