# Optional: copy to .env. No API keys needed.
# Heavy semantic model is opt-in; leave disabled on free hosting.
ENABLE_SEMANTIC=false
SEMANTIC_MODEL=sentence-transformers/all-MiniLM-L6-v2
# SQLite saving is opt-in in the UI and intended for local single-user use.
ENABLE_DATABASE=false
DATABASE_PATH=resume_intelligence.db
